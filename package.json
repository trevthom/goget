{
  "name": "nostr-ride",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:rider": "vite --mode rider",
    "dev:driver": "vite --mode driver",
    "build": "npm run build:rider && npm run build:driver",
    "build:rider": "vite build --mode rider",
    "build:driver": "vite build --mode driver",
    "preview:rider": "vite preview --mode rider",
    "preview:driver": "vite preview --mode driver",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.11.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "leaflet": "^1.9.4",
    "nostr-tools": "^2.23.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@noble/curves": "^2.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
